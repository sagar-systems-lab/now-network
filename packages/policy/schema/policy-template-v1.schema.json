{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:now:policy:template:v1",
  "title": "NOW Network policy template",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "template_key",
    "state_type",
    "fresh_ttl_seconds",
    "aging_ratio",
    "verification_class",
    "required_witnesses",
    "capture"
  ],
  "properties": {
    "template_key": {
      "type": "string",
      "pattern": "\\.v[1-9][0-9]*$"
    },
    "state_type": {
      "type": "string",
      "enum": [
        "BINARY",
        "NUMERIC",
        "VISUAL"
      ]
    },
    "fresh_ttl_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "aging_ratio": {
      "type": "number",
      "exclusiveMinimum": 0,
      "exclusiveMaximum": 1
    },
    "verification_class": {
      "type": "string",
      "enum": [
        "FAST",
        "CORROBORATED",
        "STRICT"
      ]
    },
    "required_witnesses": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "media_required",
        "location_required"
      ],
      "properties": {
        "media_required": {
          "type": "boolean"
        },
        "location_required": {
          "type": "boolean"
        },
        "video_required": {
          "type": "boolean"
        }
      }
    },
    "numeric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scale",
        "min",
        "conflict_tolerance"
      ],
      "properties": {
        "scale": {
          "type": "integer",
          "minimum": 0
        },
        "min": {
          "type": "integer"
        },
        "max": {
          "type": "integer"
        },
        "conflict_tolerance": {
          "type": "integer",
          "minimum": 0
        },
        "allow_two_of_three": {
          "type": "boolean"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state_type": {
            "const": "NUMERIC"
          }
        },
        "required": [
          "state_type"
        ]
      },
      "then": {
        "required": [
          "numeric"
        ]
      },
      "else": {
        "not": {
          "required": [
            "numeric"
          ]
        }
      }
    }
  ]
}
