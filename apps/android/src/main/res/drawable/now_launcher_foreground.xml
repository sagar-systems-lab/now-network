<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Adaptive icons render inside device-specific masks. Keep the full circuit mark
         inside Android's conservative safe zone so circular/squircle launchers cannot
         clip the top branches or side nodes. -->
    <item
        android:width="60dp"
        android:height="60dp"
        android:gravity="center">
        <bitmap
            android:src="@drawable/now_launcher_circuit"
            android:gravity="fill" />
    </item>
</layer-list>
