# NOW Network - public/local development template only.
# Never place production or privileged secrets in this file.

NOW_ENV=local
NOW_API_BASE_URL=http://127.0.0.1:54321/functions/v1/now-api
NOW_SOLANA_CLUSTER=devnet

# Backend runtime configuration. Keep real values outside Git.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_DB_URL=
SUPABASE_SERVICE_ROLE_KEY=

NOW_EVIDENCE_STORAGE_BUCKET=
NOW_EVIDENCE_MAX_BYTES=10485760

# Private keys, service-role keys, verifier keys, wallet seeds,
# signing keystores, database credentials, and deployment credentials
# must remain outside Git.
