# NOW Network - public/local development template only.
# Never place production or privileged secrets in this file.

NOW_ENV=local
NOW_API_BASE_URL=http://127.0.0.1:54321/functions/v1/now-api
NOW_SOLANA_CLUSTER=devnet

# Hosted Supabase Edge Functions inject these automatically.
# Local function runs must provide compatible local values.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_DB_URL=
SUPABASE_SERVICE_ROLE_KEY=

# API/runtime configuration.
NOW_SOLANA_RPC_URL=https://api.devnet.solana.com
NOW_REWARD_MINT=
NOW_REFRESH_LIFETIME_SECONDS=900
NOW_EVIDENCE_LEAD_SECONDS=120
NOW_CLAIM_DURATION_SECONDS=180

NOW_EVIDENCE_STORAGE_BUCKET=now-evidence
NOW_EVIDENCE_MAX_BYTES=10485760

# Internal runtime authorization. Generate 32+ character random values outside Git.
NOW_READY_TOKEN=
NOW_WORKER_TOKEN=

# Settlement worker. Keep verifier keypair material only in runtime secrets.
NOW_SETTLEMENT_VERIFIER_KEYPAIR_JSON=
NOW_WORKER_BATCH_LIMIT=8
NOW_SETTLEMENT_RECONCILE_DELAY_MS=2000
NOW_WORKER_ID=now-worker
NOW_BUILD_VERSION=dev

# Private keys, service-role keys, verifier keys, wallet seeds,
# signing keystores, database credentials, and deployment credentials
# must remain outside Git.
